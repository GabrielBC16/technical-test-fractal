# Reference only: ASP.NET Core does not automatically load .env files.
# Set these as process environment variables, Visual Studio launch environment,
# or Azure App Service environment settings. Replace all placeholders.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5213
ConnectionStrings__MaintenanceBoard=<SQL_SERVER_CONNECTION_STRING>
Cors__AllowedOrigins__0=<ANGULAR_ORIGIN>

# Optional deployment identity used only for development user seeding.
# Leave empty to use the main connection. Script 004 remains optional for this test.
ConnectionStrings__Seed=
DevelopmentSeed__Enabled=false
DevelopmentSeed__IncludeSampleTickets=true
DevelopmentSeed__Users__0__UserName=<REQUESTER_USERNAME>
DevelopmentSeed__Users__0__Names=<REQUESTER_NAMES>
DevelopmentSeed__Users__0__LastNames=<REQUESTER_LAST_NAMES>
DevelopmentSeed__Users__0__Role=Requester
DevelopmentSeed__Users__0__Password=<REQUESTER_PASSWORD>
DevelopmentSeed__Users__1__UserName=<OPERATOR_USERNAME>
DevelopmentSeed__Users__1__Names=<OPERATOR_NAMES>
DevelopmentSeed__Users__1__LastNames=<OPERATOR_LAST_NAMES>
DevelopmentSeed__Users__1__Role=Operator
DevelopmentSeed__Users__1__Password=<OPERATOR_PASSWORD>
DevelopmentSeed__Users__2__UserName=<SUPERVISOR_USERNAME>
DevelopmentSeed__Users__2__Names=<SUPERVISOR_NAMES>
DevelopmentSeed__Users__2__LastNames=<SUPERVISOR_LAST_NAMES>
DevelopmentSeed__Users__2__Role=Supervisor
DevelopmentSeed__Users__2__Password=<SUPERVISOR_PASSWORD>

# Optional real SQL tests: use a database whose name starts with MaintenanceBoard_Validation.
# MAINTENANCEBOARD_TEST_CONNECTION_STRING=<ISOLATED_SQL_TEST_CONNECTION_STRING>
